{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
  /* ===================================================
     FAQ SECTION — EXACT MOCKUP MATCH
     =================================================== */

  .shea-faq-section {
    background-color: #FFC923;
    position: relative;
    overflow: hidden;
    padding: 40px 0 60px;
  }

  /* ── Confetti SVG layer (scattered all over) ── */
  .shea-faq-confetti {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  /* ── Inner container ── */
  .shea-faq-inner {
    position: relative;
    z-index: 2;
    max-width: {{ section.settings.container_max_width | default: 960 }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ===================================================
     HEADER: Left title + Right necklace
     =================================================== */
  .shea-faq-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 36px;
  }

  .shea-faq-header-left {
    flex: 1 1 0;
    min-width: 0;
  }

  .shea-faq-header-right {
    flex: 0 0 220px;
    width: 220px;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    margin-top: -10px;
  }

  .shea-faq-header-right img {
    width: 220px;
    height: auto;
    display: block;
    object-fit: contain;
    filter: drop-shadow(0 6px 0 rgba(126,73,16,0.18));
  }

  /* Necklace placeholder when no image uploaded */
  .shea-faq-necklace-placeholder {
    width: 220px;
    height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── Giant cartoon title ── */
  .shea-faq-title {
    font-family: var(--shea-font-display, 'Fredoka', sans-serif);
    font-size: clamp(3.2rem, 8vw, 5.6rem);
    font-weight: 800;
    color: #F05534;
    text-transform: uppercase;
    line-height: 0.92;
    letter-spacing: -1px;
    margin: 0 0 20px 0;
    /* White outline + brown shadow = 3D cartoon effect */
    -webkit-text-stroke: 4px #FFFFFF;
    paint-order: stroke fill;
    text-shadow:
      6px 6px 0 rgba(126, 73, 16, 0.30);
  }

  .shea-faq-title span {
    display: block;
  }

  /* ── Subheading below title ── */
  .shea-faq-subtext {
    font-family: var(--shea-font-body, 'Quicksand', sans-serif);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    font-weight: 700;
    color: #4A2C11;
    line-height: 1.5;
    margin: 0;
    max-width: 520px;
  }

  .shea-faq-subtext .faq-squad-link {
    color: #0CBFA5;
    font-weight: 800;
  }

  /* ===================================================
     FAQ ACCORDION LIST
     =================================================== */
  .shea-faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 32px;
  }

  .shea-faq-item {
    background: #FFFFFF;
    border: 3px solid #4A2C11;
    border-radius: 18px;
    box-shadow: 0 5px 0 rgba(74, 44, 17, 0.22);
    overflow: hidden;
    transition: box-shadow 0.2s ease;
  }

  .shea-faq-item[open] {
    box-shadow: 0 5px 0 rgba(74, 44, 17, 0.22);
  }

  .shea-faq-summary {
    padding: 16px 20px 16px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
    user-select: none;
    gap: 14px;
    -webkit-tap-highlight-color: transparent;
  }

  .shea-faq-summary::-webkit-details-marker {
    display: none;
  }

  .shea-faq-q-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 1;
    min-width: 0;
  }

  /* Teal circular "?" badge — exactly like mockup */
  .shea-faq-badge {
    width: 36px;
    height: 36px;
    min-width: 36px;
    border-radius: 50%;
    background: #0CBFA5;
    border: 2.5px solid #4A2C11;
    box-shadow: 0 3px 0 #4A2C11;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--shea-font-display, 'Fredoka', sans-serif);
    font-size: 1.3rem;
    font-weight: 800;
    color: #FFFFFF;
    flex-shrink: 0;
    line-height: 1;
  }

  .shea-faq-question {
    font-family: var(--shea-font-display, 'Fredoka', sans-serif);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    font-weight: 700;
    color: #4A2C11;
    line-height: 1.3;
    text-align: left;
  }

  /* Chevron icon */
  .shea-faq-chevron {
    width: 26px;
    height: 26px;
    min-width: 26px;
    flex-shrink: 0;
    transition: transform 0.25s ease;
    color: #4A2C11;
  }

  .shea-faq-item[open] .shea-faq-chevron {
    transform: rotate(180deg);
  }

  /* Answer content */
  .shea-faq-answer {
    padding: 2px 20px 18px 66px;
    font-family: var(--shea-font-body, 'Quicksand', sans-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: #4A2C11;
    line-height: 1.55;
  }

  .shea-faq-answer p {
    margin: 0 0 8px;
  }

  .shea-faq-answer p:last-child {
    margin-bottom: 0;
  }

  .shea-faq-answer a {
    color: #0CBFA5;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .shea-faq-answer a:hover {
    color: #F05534;
  }

  /* ===================================================
     BOTTOM CTA CARD — Mascot | Text | Jar
     =================================================== */
  .shea-faq-cta-card {
    background: #FFF9E6;
    border: 3.5px solid #4A2C11;
    border-radius: 24px;
    box-shadow: 0 6px 0 rgba(74, 44, 17, 0.22);
    display: flex;
    align-items: center;
    gap: 0;
    overflow: hidden;
    min-height: 130px;
  }

  /* Left mascot slot */
  .shea-faq-cta-mascot {
    flex: 0 0 140px;
    width: 140px;
    min-height: 130px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0;
    overflow: hidden;
  }

  .shea-faq-cta-mascot img {
    width: 140px;
    height: auto;
    display: block;
    object-fit: contain;
  }

  /* Mascot placeholder */
  .shea-faq-cta-mascot-placeholder {
    width: 140px;
    height: 130px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Center text block */
  .shea-faq-cta-text {
    flex: 1 1 0;
    text-align: center;
    padding: 20px 12px;
  }

  .shea-faq-cta-heading {
    font-family: var(--shea-font-display, 'Fredoka', sans-serif);
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 800;
    color: #4A2C11;
    margin: 0 0 4px;
    line-height: 1.2;
  }

  .shea-faq-cta-sub {
    font-family: var(--shea-font-body, 'Quicksand', sans-serif);
    font-size: 1rem;
    font-weight: 700;
    color: #4A2C11;
    margin: 0 0 16px;
  }

  .shea-faq-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #F05534;
    color: #FFFFFF;
    font-family: var(--shea-font-display, 'Fredoka', sans-serif);
    font-size: 1.15rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 12px 32px;
    border-radius: 50px;
    border: 3px solid #4A2C11;
    box-shadow: 0 5px 0 #4A2C11;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .shea-faq-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 7px 0 #4A2C11;
    color: #FFFFFF;
  }

  .shea-faq-cta-btn:active {
    transform: translateY(3px);
    box-shadow: 0 2px 0 #4A2C11;
  }

  /* Right jar slot */
  .shea-faq-cta-jar {
    flex: 0 0 130px;
    width: 130px;
    min-height: 130px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
  }

  .shea-faq-cta-jar img {
    width: 120px;
    height: auto;
    display: block;
    object-fit: contain;
  }

  /* Jar placeholder */
  .shea-faq-cta-jar-placeholder {
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ===================================================
     RESPONSIVE
     =================================================== */
  @media (max-width: 750px) {
    .shea-faq-header-right {
      flex: 0 0 160px;
      width: 160px;
    }
    .shea-faq-header-right img,
    .shea-faq-necklace-placeholder {
      width: 160px;
    }
    .shea-faq-title {
      -webkit-text-stroke: 3px #FFFFFF;
    }
    .shea-faq-cta-mascot,
    .shea-faq-cta-mascot-placeholder {
      flex: 0 0 100px;
      width: 100px;
    }
    .shea-faq-cta-jar,
    .shea-faq-cta-jar-placeholder {
      flex: 0 0 90px;
      width: 90px;
    }
    .shea-faq-cta-jar img {
      width: 90px;
    }
  }

  @media (max-width: 560px) {
    .shea-faq-header-right {
      display: none;
    }
    .shea-faq-answer {
      padding-left: 52px;
    }
    .shea-faq-cta-mascot,
    .shea-faq-cta-jar {
      display: none;
    }
  }
</style>

