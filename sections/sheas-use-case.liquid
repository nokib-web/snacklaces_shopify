{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #SheaUseCase-{{ section.id }} .shea-usecase-container {
    max-width: {{ section.settings.container_max_width | default: 1200 }}px;
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    box-sizing: border-box;
  }

  .shea-usecase-hero-wrap {
    text-align: center;
    width: 100%;
    margin: 0 auto 36px;
  }

  .shea-usecase-ribbon {
    display: inline-block;
    background: var(--shea-teal, #0CBFA5);
    color: #FFFFFF;
    font-family: var(--shea-font-display, 'Fredoka', cursive, sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    padding: 8px 24px;
    border-radius: var(--shea-radius-pill, 9999px);
    border: 2.5px solid var(--shea-border-color, #7E4910);
    box-shadow: 0 4px 0 rgba(126, 73, 16, 0.2);
    margin-bottom: 20px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .shea-usecase-ribbon:hover {
    transform: scale(1.05) rotate(-1deg);
  }

  /* Dynamic Banner Image Container */
  .shea-usecase-img-wrap {
    width: {{ section.settings.image_width_percent | default: 100 }}%;
    max-width: 100%;
    margin: 0 auto 36px;
    {%- if section.settings.show_image_card -%}
      border-radius: var(--shea-radius-card, 24px);
      overflow: hidden;
      border: 3.5px solid var(--shea-border-color, #7E4910);
      box-shadow: var(--shea-shadow-card, 0 8px 0 rgba(126, 73, 16, 0.18));
      background: #FFFFFF;
    {%- else -%}
      border: none;
      box-shadow: none;
      background: transparent;
    {%- endif -%}
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
  }

  .shea-usecase-img-wrap:hover {
    transform: translateY(-4px);
    {%- if section.settings.show_image_card -%}
      box-shadow: 0 14px 0 rgba(126, 73, 16, 0.22);
    {%- endif -%}
  }

  .shea-usecase-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* 3 Features Pillars Grid */
  .shea-usecase-features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    width: 100%;
    margin-bottom: 40px;
  }

  .shea-usecase-feat-card {
    background: #FFFFFF;
    border: 3px solid var(--shea-border-color, #7E4910);
    border-radius: var(--shea-radius-card, 24px);
    box-shadow: var(--shea-shadow-card, 0 8px 0 rgba(126, 73, 16, 0.18));
    padding: 28px 22px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease;
  }

  .shea-usecase-feat-card:hover {
    transform: translateY(-8px) scale(1.015);
    box-shadow: 0 16px 0 rgba(126, 73, 16, 0.22);
  }

  .shea-usecase-feat-icon {
    font-size: 2.8rem;
    line-height: 1;
    margin-bottom: 14px;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .shea-usecase-feat-card:hover .shea-usecase-feat-icon {
    transform: scale(1.2) rotate(-6deg);
  }

  .shea-usecase-feat-title {
    font-family: var(--shea-font-display, 'Fredoka', cursive, sans-serif);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--shea-teal, #0CBFA5);
    margin: 0 0 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.2;
  }

  .shea-usecase-feat-desc {
    font-family: var(--shea-font-body, 'Quicksand', sans-serif);
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--shea-dark-brown, #4A2C11);
    margin: 0;
  }

  .shea-usecase-cta-wrap {
    text-align: center;
    margin: 10px 0 20px;
  }

  .shea-usecase-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background-color: var(--shea-coral, #F05534);
    color: #FFFFFF !important;
    font-family: var(--shea-font-display, 'Fredoka', cursive, sans-serif);
    font-size: 1.35rem;
    font-weight: 800;
    text-decoration: none;
    padding: 16px 48px;
    border-radius: var(--shea-radius-pill, 9999px);
    border: 3.5px solid var(--shea-border-color, #7E4910);
    box-shadow: 0 6px 0 var(--shea-border-color, #7E4910);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease, background-color 0.2s ease;
    cursor: pointer;
  }

  .shea-usecase-cta-btn:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 10px 0 var(--shea-border-color, #7E4910);
    background-color: #E04423;
  }

  .shea-usecase-cta-btn:active {
    transform: translateY(2px) scale(0.99);
    box-shadow: 0 2px 0 var(--shea-border-color, #7E4910);
  }

  @media (max-width: 850px) {
    .shea-usecase-features-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .shea-usecase-cta-btn {
      width: 100%;
      padding: 16px 24px;
      font-size: 1.2rem;
    }
  }
{%- endstyle -%}

<div id="SheaUseCase-{{ section.id }}" class="section-{{ section.id }}-padding {% if section.settings.enable_confetti %}shea-confetti-bg{% endif %}">
  <div class="shea-container">
    <div class="shea-usecase-container">
      <!-- Header Block -->
      <div class="shea-usecase-hero-wrap">
        <h1 class="shea-section-title" style="font-size: clamp(2.2rem, 5vw, 3.8rem); line-height: 1.08; color: {{ section.settings.title_color | default: '#F05534' }};">
          {{ section.settings.heading }}
        </h1>

        {%- if section.settings.ribbon_text != blank -%}
          <div>
            <div class="shea-usecase-ribbon">
              {{ section.settings.ribbon_text }}
            </div>
          </div>
        {%- endif -%}

        <p class="shea-section-subhead" style="font-size: 1.2rem; max-width: 720px; margin: 0 auto;">
          {{ section.settings.subhead }}
        </p>
      </div>

      <!-- Main Scene Illustration (Dynamic Full-Width Match) -->
      {%- liquid
        assign scene_img_src = ''
        if section.settings.scene_image != blank
          assign scene_img_src = section.settings.scene_image | image_url: width: 1400
        elsif section.settings.fallback_asset_name != blank
          assign scene_img_src = section.settings.fallback_asset_name | asset_url
        elsif template.suffix == 'kids-parties'
          assign scene_img_src = 'hero-kids-parties.jpg' | asset_url
        elsif template.suffix == 'gifts'
          assign scene_img_src = 'hero-gift-packages.jpg' | asset_url
        elsif template.suffix == 'fundraiser'
          assign scene_img_src = 'hero-school-fundraiser.jpg' | asset_url
        elsif template.suffix == 'at-home'
          assign scene_img_src = 'hero-at-home.jpg' | asset_url
        elsif template.suffix == 'events'
          assign scene_img_src = 'hero-events.jpg' | asset_url
        endif
      -%}

      {%- if scene_img_src != blank -%}
        <div class="shea-usecase-img-wrap">
          <img src="{{ scene_img_src }}" 
               alt="{{ section.settings.heading | escape }}" 
               class="shea-usecase-img" 
               loading="eager">
        </div>
      {%- endif -%}

      <!-- 3 Features Pillars -->
      <div class="shea-usecase-features-grid">
        {%- for block in section.blocks -%}
          <div class="shea-usecase-feat-card" {{ block.shopify_attributes }}>
            <div class="shea-usecase-feat-icon">
              {%- if block.settings.custom_icon != blank -%}
                {{ block.settings.custom_icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: block.settings.title }}
              {%- else -%}
                {{ block.settings.emoji_icon | default: '🥨' }}
              {%- endif -%}
            </div>
            <h3 class="shea-usecase-feat-title" style="color: {{ block.settings.title_color | default: '#0CBFA5' }};">
              {{ block.settings.title }}
            </h3>
            <p class="shea-usecase-feat-desc">{{ block.settings.desc }}</p>
          </div>
        {%- endfor -%}
      </div>

      <!-- Main CTA Button -->
      {%- if section.settings.btn_label != blank -%}
        <div class="shea-usecase-cta-wrap">
          <a href="{{ section.settings.btn_link | default: '/collections/all' }}" class="shea-usecase-cta-btn">
            {{ section.settings.btn_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shea Use-Case Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page Main Title",
      "default": "THE PARTY FAVOR KIDS ACTUALLY LOVE!"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#F05534"
    },
    {
      "type": "text",
      "id": "ribbon_text",
      "label": "Ribbon Tagline",
      "default": "FUN TO WEAR. EVEN BETTER TO EAT! 🥨"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subheadline",
      "default": "The sweetest way to celebrate birthdays, holidays, and any fun gathering!"
    },
    {
      "type": "image_picker",
      "id": "scene_image",
      "label": "Main Scene Illustration"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 800,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Section Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "image_width_percent",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Banner Image Width (% of container)",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "show_image_card",
      "label": "Show Card Border & Shadow on Banner Image",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "CTA Button Label",
      "default": "SHOP PARTY PACKS →"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "CTA Button Link"
    },
    {
      "type": "checkbox",
      "id": "enable_confetti",
      "label": "Enable Confetti Background",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "Feature Pillar Card",
      "settings": [
        {
          "type": "text",
          "id": "emoji_icon",
          "label": "Emoji Icon",
          "default": "🎂"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "PERFECT FOR PARTIES"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#0CBFA5"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Card Description",
          "default": "The yummiest party favor that kids will love to wear and snack on!"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shea Use-Case Section",
      "blocks": [
        {
          "type": "feature_card",
          "settings": {
            "emoji_icon": "🎂",
            "title": "PERFECT FOR PARTIES",
            "title_color": "#0CBFA5",
            "desc": "The yummiest party favor that kids will love to wear and snack on!"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "emoji_icon": "🎁",
            "title": "EASY & CONVENIENT",
            "title_color": "#F05534",
            "desc": "Pre-packaged and ready to go — saving you time so you can enjoy the fun!"
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "emoji_icon": "🧒",
            "title": "KIDS APPROVED",
            "title_color": "#0CBFA5",
            "desc": "Delicious, fun to wear, and made with quality ingredients you can trust."
          }
        }
      ]
    }
  ]
}
{% endschema %}
