{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .shea-shipping-top-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 32px;
  }

  .shea-shipping-card {
    background: #FFFFFF;
    border: 3px solid var(--shea-border-color);
    border-radius: var(--shea-radius-card);
    box-shadow: var(--shea-shadow-card);
    padding: 24px 20px;
    text-align: center;
    transition: transform 0.2s ease;
  }

  .shea-shipping-card:hover {
    transform: translateY(-4px);
  }

  .shea-shipping-icon-wrap {
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }

  .shea-shipping-icon-wrap img,
  .shea-shipping-icon-wrap svg {
    max-height: 100px;
    max-width: 100%;
  }

  .shea-shipping-card-title {
    font-size: 1.25rem;
    color: var(--shea-teal);
    margin: 0 0 8px;
    text-transform: uppercase;
  }

  .shea-shipping-card-desc {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--shea-dark-brown);
    margin: 0;
  }

  /* Warm Weather Banner */
  .shea-melt-banner {
    background: #FFFBEA;
    border: 3.5px solid var(--shea-border-color);
    border-radius: var(--shea-radius-card);
    box-shadow: var(--shea-shadow-card);
    padding: 24px 32px;
    margin-bottom: 36px;
    display: grid;
    grid-template-columns: 90px 1fr 100px;
    align-items: center;
    gap: 20px;
  }

  .shea-melt-title {
    font-size: 1.35rem;
    color: var(--shea-coral);
    margin: 0 0 6px;
  }

  .shea-melt-text {
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0;
  }

  .shea-shipping-badges-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 36px;
  }

  .shea-ship-badge-item {
    background: #FFFFFF;
    border: 3px solid var(--shea-border-color);
    border-radius: 18px;
    box-shadow: var(--shea-shadow-card);
    padding: 20px 16px;
    text-align: center;
  }

  .shea-ship-badge-icon {
    font-size: 2.2rem;
    margin-bottom: 8px;
  }

  .shea-ship-badge-title {
    font-size: 1.05rem;
    color: var(--shea-teal);
    margin: 0 0 6px;
    text-transform: uppercase;
  }

  .shea-ship-badge-desc {
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0;
  }

  /* Signature Box */
  .shea-cso-banner {
    background: #FFFDF4;
    border: 3.5px solid var(--shea-border-color);
    border-radius: var(--shea-radius-card);
    box-shadow: var(--shea-shadow-card);
    padding: 20px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .shea-cso-title {
    font-size: 1.25rem;
    color: var(--shea-coral);
    margin: 0 0 4px;
    text-transform: uppercase;
  }

  .shea-cso-sub {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
  }

  @media (max-width: 850px) {
    .shea-shipping-top-grid {
      grid-template-columns: 1fr;
      max-width: 400px;
      margin-left: auto;
      margin-right: auto;
    }
    .shea-melt-banner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .shea-shipping-badges-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .shea-cso-banner {
      flex-direction: column;
      text-align: center;
    }
  }

  @media (max-width: 550px) {
    .shea-shipping-badges-grid {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<div id="SheaShipping-{{ section.id }}" class="section-{{ section.id }}-padding {% if section.settings.enable_confetti %}shea-confetti-bg{% endif %}">
  <div class="shea-container">
    <div class="shea-section-header">
      <h2 class="shea-section-title">{{ section.settings.heading | default: "GETTING YOUR SNACKLACE" }}</h2>
      <p class="shea-section-subhead">
        {{ section.settings.subhead | default: "We pack every Snacklace with care so it arrives fresh, yummy, and ready to wear (and snack)!" }}
      </p>
    </div>

    <!-- 3 Top Cards -->
    <div class="shea-shipping-top-grid">
      <!-- Card 1: Fast Shipping -->
      <div class="shea-shipping-card">
        <div class="shea-shipping-icon-wrap">
          {%- if section.settings.truck_img != blank -%}
            {{ section.settings.truck_img | image_url: width: 250 | image_tag: loading: 'lazy', alt: "Fast Shipping" }}
          {%- else -%}
            <img src="{{ 'shipping-truck.jpg' | asset_url }}" alt="Fast Shipping Truck" class="shea-shipping-icon-img" style="max-height: 100px; border-radius: 12px;" loading="lazy">
          {%- endif -%}
        </div>
        <h3 class="shea-shipping-card-title">✨ FAST SHIPPING ✨</h3>
        <p class="shea-shipping-card-desc">Orders ship in 1–2 business days. You'll get a tracking email as soon as your Snacklace is on its way!</p>
      </div>

      <!-- Card 2: Packed with Care -->
      <div class="shea-shipping-card">
        <div class="shea-shipping-icon-wrap">
          {%- if section.settings.gift_img != blank -%}
            {{ section.settings.gift_img | image_url: width: 250 | image_tag: loading: 'lazy', alt: "Packed with Care" }}
          {%- else -%}
            <img src="{{ 'shipping-giftbox.png' | asset_url }}" alt="Packed with Care Giftbox" class="shea-shipping-icon-img" style="max-height: 100px; border-radius: 12px;" loading="lazy">
          {%- endif -%}
        </div>
        <h3 class="shea-shipping-card-title">PACKED WITH CARE</h3>
        <p class="shea-shipping-card-desc">We pack everything by hand with lots of love (and bubble wrap!) to keep your Snacklace safe and snack-tastic.</p>
      </div>

      <!-- Card 3: Local Pickup -->
      <div class="shea-shipping-card">
        <div class="shea-shipping-icon-wrap">
          {%- if section.settings.house_img != blank -%}
            {{ section.settings.house_img | image_url: width: 250 | image_tag: loading: 'lazy', alt: "Local Pickup" }}
          {%- else -%}
            <img src="{{ 'shipping-house.png' | asset_url }}" alt="Local Pickup House" class="shea-shipping-icon-img" style="max-height: 100px; border-radius: 12px;" loading="lazy">
          {%- endif -%}
        </div>
        <h3 class="shea-shipping-card-title">🏡 LOCAL PICKUP</h3>
        <p class="shea-shipping-card-desc">Live nearby? Choose local pickup at checkout and we'll have your order ready for you. Yay, no shipping!</p>
      </div>
    </div>

    <!-- Warm Weather Note Banner -->
    <div class="shea-melt-banner">
      <div style="text-align: center;">
        <img src="{{ 'shipping-sun-chocolate.jpg' | asset_url }}" alt="Sun and Chocolate" style="width: 75px; height: 75px; border-radius: 50%; object-fit: cover;" loading="lazy">
      </div>
      <div>
        <h3 class="shea-melt-title">{{ section.settings.melt_title | default: "WARM WEATHER NOTE:" }}</h3>
        <p class="shea-melt-text">
          {{ section.settings.melt_text | default: "Chocolate can get melty in hot weather! We use extra care and cool packaging, but we recommend snacking within a few days for best taste and crunch." }}
        </p>
      </div>
      <div style="font-size: 2.8rem; text-align: center;">🍫</div>
    </div>

    <!-- 4 Info Badges Grid -->
    <div class="shea-shipping-badges-grid">
      <div class="shea-ship-badge-item">
        <div class="shea-ship-badge-icon">📅</div>
        <h4 class="shea-ship-badge-title">PROCESSING TIME</h4>
        <p class="shea-ship-badge-desc">We need 1–2 business days to make and pack your fresh order.</p>
      </div>
      <div class="shea-ship-badge-item">
        <div class="shea-ship-badge-icon">🥨</div>
        <h4 class="shea-ship-badge-title">FRESHNESS FIRST</h4>
        <p class="shea-ship-badge-desc">Snacklaces stay fresh and crunchy for up to 3 weeks sealed!</p>
      </div>
      <div class="shea-ship-badge-item">
        <div class="shea-ship-badge-icon">🛡️</div>
        <h4 class="shea-ship-badge-title">SAFE & SECURE</h4>
        <p class="shea-ship-badge-desc">We use secure 256-bit checkout and never share your info.</p>
      </div>
      <div class="shea-ship-badge-item">
        <div class="shea-ship-badge-icon">📍</div>
        <h4 class="shea-ship-badge-title">WHERE WE SHIP</h4>
        <p class="shea-ship-badge-desc">We ship across the U.S. Remote areas may take extra time.</p>
      </div>
    </div>

    <!-- Bottom Signature Banner -->
    <div class="shea-cso-banner">
      <div>
        <h4 class="shea-cso-title">MADE WITH LOVE. DELIVERED WITH CARE. ❤️</h4>
        <p class="shea-cso-sub">Thanks for supporting my little snack business! Wear it. Snack it. Love it. 🥨 — Shea (aka Chief Snack Officer)</p>
      </div>
      <a href="{{ section.settings.shop_link | default: '/collections/all' }}" class="shea-btn shea-btn-coral">
        SHOP NOW →
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shea Shipping",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "GETTING YOUR SNACKLACE"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Section Subheading",
      "default": "We pack every Snacklace with care so it arrives fresh, yummy, and ready to wear (and snack)!"
    },
    {
      "type": "image_picker",
      "id": "truck_img",
      "label": "Fast Shipping Truck Image"
    },
    {
      "type": "image_picker",
      "id": "gift_img",
      "label": "Packed With Care Giftbox Image"
    },
    {
      "type": "image_picker",
      "id": "house_img",
      "label": "Local Pickup House Image"
    },
    {
      "type": "text",
      "id": "melt_title",
      "label": "Warm Weather Title",
      "default": "WARM WEATHER NOTE:"
    },
    {
      "type": "textarea",
      "id": "melt_text",
      "label": "Warm Weather Copy",
      "default": "Chocolate can get melty in hot weather! We use extra care and cool packaging, but we recommend snacking within a few days for best taste and crunch."
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Bottom Shop Link"
    },
    {
      "type": "checkbox",
      "id": "enable_confetti",
      "label": "Enable Confetti Background",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Shea Shipping"
    }
  ]
}
{% endschema %}
