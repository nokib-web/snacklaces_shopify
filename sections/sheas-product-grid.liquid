                        <path d="M124 116 L128 120 L132 116 L128 112 Z" fill="#FFFFFF"/>
                    {%- endcase -%}
                  </svg>
                {%- endif -%}
              </div>

              <p class="shea-product-desc">{{ block.settings.description }}</p>
            </div>

            <div class="shea-product-footer">
              <span class="shea-price-pill">{{ block.settings.price }}</span>
              <a href="{{ block.settings.product_link | default: '/collections/all' }}" class="shea-circle-btn" aria-label="Buy {{ block.settings.title }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shea Product Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading (Optional)"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Section Subheading (Optional)"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shopify Collection (Optional)",
      "info": "Leave empty to use custom flavor blocks below"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Maximum Products to Show",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "flavor_card",
      "name": "Flavor Card",
      "settings": [
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text (e.g. 🥨 ORIGINAL)",
          "default": "🥨 ORIGINAL"
        },
        {
          "type": "color",
          "id": "badge_bg",
          "label": "Badge Background Color",
          "default": "#FFF0ED"
        },
        {
          "type": "color",
          "id": "badge_color",
          "label": "Badge Text Color",
          "default": "#F05534"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "PRETZEL SNACKLACE"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#F05534"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Image"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short Description",
          "default": "Classic, salty, and always a favorite!"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price Display",
          "default": "$3.00"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shea Product Grid",
      "blocks": [
        {
          "type": "flavor_card",
          "settings": {
            "badge_text": "🥨 ORIGINAL",
            "title": "PRETZEL SNACKLACE",
            "title_color": "#F05534",
            "description": "Classic, salty, and always a favorite!",
            "price": "$3.00"
          }
        },
        {
          "type": "flavor_card",
          "settings": {
            "badge_text": "🍫 CHOCOLATE",
            "title": "CHOCOLATE PRETZEL",
            "title_color": "#0CBFA5",
            "description": "Sweet chocolate + salty crunch!",
            "price": "$5.00"
          }
        },
        {
          "type": "flavor_card",
          "settings": {
            "badge_text": "🤍 WHITE CHOC",
            "title": "WHITE CHOCOLATE PRETZEL",
            "title_color": "#0CBFA5",
            "description": "Sweet, creamy, and oh-so-delicious!",
            "price": "$5.00"
          }
        },
        {
          "type": "flavor_card",
          "settings": {
            "badge_text": "🌾 GLUTEN-FREE",
            "title": "GLUTEN-FREE PRETZEL",
            "title_color": "#F05534",
            "description": "All the fun. None of the gluten.",
            "price": "$5.00"
          }
        }
      ]
    }
  ]
}
{% endschema %}
