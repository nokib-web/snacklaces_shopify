                <line x1="34" y1="34"  x2="27" y2="27"  stroke="white" stroke-width="3" stroke-linecap="round"/>
                <line x1="0"  y1="48"  x2="0"  y2="38"  stroke="white" stroke-width="3" stroke-linecap="round"/>
                <line x1="-34" y1="34" x2="-27" y2="27" stroke="white" stroke-width="3" stroke-linecap="round"/>
                <line x1="-48" y1="0"  x2="-38" y2="0"  stroke="white" stroke-width="3" stroke-linecap="round"/>
                <line x1="-34" y1="-34" x2="-27" y2="-27" stroke="white" stroke-width="3" stroke-linecap="round"/>
              </g>
              <!-- Pretzel shape -->
              <g transform="translate(110, 210)">
                <!-- Pretzel body path -->
                <path d="M0,-38 C-15,-38 -26,-26 -26,-12 C-26,2 -15,12 0,12 C15,12 26,2 26,-12 C26,-20 20,-28 12,-32 L0,-38Z" fill="#D4872A" stroke="#4A2C11" stroke-width="3" stroke-linejoin="round"/>
                <path d="M0,-38 C15,-38 26,-26 26,-12 C26,2 15,12 0,12 C-15,12 -26,2 -26,-12 C-26,-20 -20,-28 -12,-32 L0,-38Z" fill="#E8A040" stroke="#4A2C11" stroke-width="3" stroke-linejoin="round"/>
                <!-- Pretzel loops -->
                <ellipse cx="-16" cy="-8" rx="11" ry="14" fill="#D4872A" stroke="#4A2C11" stroke-width="2.5"/>
                <ellipse cx="16"  cy="-8" rx="11" ry="14" fill="#D4872A" stroke="#4A2C11" stroke-width="2.5"/>
                <!-- Bottom knot -->
                <ellipse cx="0" cy="20" rx="16" ry="10" fill="#E8A040" stroke="#4A2C11" stroke-width="2.5"/>
                <!-- Salt dots -->
                <circle cx="-18" cy="-10" r="2.5" fill="white"/>
                <circle cx="-12" cy="-2"  r="2"   fill="white"/>
                <circle cx="18"  cy="-10" r="2.5" fill="white"/>
                <circle cx="12"  cy="-2"  r="2"   fill="white"/>
                <circle cx="-4"  cy="18"  r="2"   fill="white"/>
                <circle cx="5"   cy="22"  r="2"   fill="white"/>
              </g>
            </svg>
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- ═══ FAQ ACCORDION LIST ═══ -->
    <div class="shea-faq-list">
      {%- for block in section.blocks -%}
        <details
          class="shea-faq-item"
          {% if forloop.first and section.settings.open_first %}open{% endif %}
          {{ block.shopify_attributes }}>

          <summary class="shea-faq-summary">
            <div class="shea-faq-q-row">
              <span class="shea-faq-badge" aria-hidden="true">?</span>
              <span class="shea-faq-question">{{ block.settings.question }}</span>
            </div>
            <svg class="shea-faq-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>

          <div class="shea-faq-answer">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endfor -%}
    </div>

    <!-- ═══ BOTTOM CTA CARD ═══ -->
    {%- if section.settings.show_contact_card -%}
      <div class="shea-faq-cta-card">

        <!-- Left: Mascot (user uploads later) -->
        <div class="shea-faq-cta-mascot">
          {%- if section.settings.mascot_image != blank -%}
            <img
              src="{{ section.settings.mascot_image | image_url: width: 280 }}"
              alt="Shea Mascot"
              width="140"
              loading="lazy">
          {%- else -%}
            <!-- Inline SVG boy mascot placeholder -->
            <div class="shea-faq-cta-mascot-placeholder">
              <svg width="120" height="130" viewBox="0 0 120 130" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Body -->
                <rect x="30" y="75" width="60" height="50" rx="12" fill="#0CBFA5" stroke="#4A2C11" stroke-width="2.5"/>
                <!-- Head -->
                <ellipse cx="60" cy="55" rx="28" ry="30" fill="#F7D08A" stroke="#4A2C11" stroke-width="2.5"/>
                <!-- Hair -->
                <path d="M32 42 C 35 22, 85 22, 88 42 C 80 30, 40 30, 32 42Z" fill="#FFD966" stroke="#4A2C11" stroke-width="2"/>
                <!-- Eyes -->
                <ellipse cx="48" cy="52" rx="5" ry="6" fill="white" stroke="#4A2C11" stroke-width="1.5"/>
                <ellipse cx="72" cy="52" rx="5" ry="6" fill="white" stroke="#4A2C11" stroke-width="1.5"/>
                <circle cx="50" cy="54" r="3" fill="#4A2C11"/>
                <circle cx="74" cy="54" r="3" fill="#4A2C11"/>
                <!-- Big smile -->
                <path d="M44 66 Q60 78 76 66" stroke="#4A2C11" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                <!-- Cheeks -->
                <circle cx="42" cy="64" r="6" fill="#F05534" opacity="0.35"/>
                <circle cx="78" cy="64" r="6" fill="#F05534" opacity="0.35"/>
                <!-- Thumb up arm -->
                <rect x="82" y="80" width="14" height="35" rx="7" fill="#F7D08A" stroke="#4A2C11" stroke-width="2" transform="rotate(-15 82 80)"/>
                <!-- Thumb -->
                <ellipse cx="100" cy="73" rx="8" ry="10" fill="#F7D08A" stroke="#4A2C11" stroke-width="2"/>
                <!-- Bead necklace -->
                <circle cx="44" cy="82" r="4" fill="#F05534" stroke="#4A2C11" stroke-width="1.5"/>
                <circle cx="52" cy="78" r="4" fill="#FFAD00" stroke="#4A2C11" stroke-width="1.5"/>
                <circle cx="60" cy="77" r="4" fill="#0CBFA5" stroke="#4A2C11" stroke-width="1.5"/>
                <circle cx="68" cy="78" r="4" fill="#F05534" stroke="#4A2C11" stroke-width="1.5"/>
                <circle cx="76" cy="82" r="4" fill="#FFAD00" stroke="#4A2C11" stroke-width="1.5"/>
              </svg>
            </div>
          {%- endif -%}
        </div>

        <!-- Center: Text & Button -->
        <div class="shea-faq-cta-text">
          <h3 class="shea-faq-cta-heading">{{ section.settings.contact_heading | default: "Still have a question?" }}</h3>
          <p class="shea-faq-cta-sub">{{ section.settings.contact_subhead | default: "We're here to help and love hearing from you! 🧡" }}</p>
          <a href="{{ section.settings.contact_link | default: '/pages/contact' }}" class="shea-faq-cta-btn">
            {{ section.settings.contact_btn_label | default: "CONTACT US" }} &rarr;
          </a>
        </div>

        <!-- Right: Jar (user uploads later) -->
        <div class="shea-faq-cta-jar">
          {%- if section.settings.jar_image != blank -%}
            <img
              src="{{ section.settings.jar_image | image_url: width: 240 }}"
              alt="Pretzel Jar"
              width="120"
              loading="lazy">
          {%- else -%}
            <!-- Inline SVG jar placeholder -->
            <div class="shea-faq-cta-jar-placeholder">
              <svg width="110" height="120" viewBox="0 0 110 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Jar body -->
                <rect x="18" y="35" width="74" height="78" rx="12" fill="white" fill-opacity="0.85" stroke="#4A2C11" stroke-width="2.5"/>
                <!-- Jar highlight -->
                <rect x="24" y="42" width="16" height="50" rx="8" fill="white" opacity="0.5"/>
                <!-- Lid -->
                <rect x="14" y="22" width="82" height="18" rx="9" fill="#B0B0B0" stroke="#4A2C11" stroke-width="2.5"/>
                <!-- Pretzels in jar -->
                <g transform="translate(55, 60)">
                  <ellipse cx="-10" cy="-5" rx="9" ry="11" fill="#D4872A" stroke="#4A2C11" stroke-width="2"/>
                  <ellipse cx="10"  cy="-5" rx="9" ry="11" fill="#E8A040" stroke="#4A2C11" stroke-width="2"/>
                  <ellipse cx="0"   cy="8"  rx="9" ry="11" fill="#D4872A" stroke="#4A2C11" stroke-width="2"/>
                  <circle cx="-12" cy="-7" r="2" fill="white"/>
                  <circle cx="12"  cy="-7" r="2" fill="white"/>
                  <circle cx="0"   cy="6"  r="2" fill="white"/>
                </g>
                <!-- Pretzel sticking out top -->
                <ellipse cx="55" cy="26" rx="12" ry="8" fill="#E8A040" stroke="#4A2C11" stroke-width="2"/>
                <circle cx="50" cy="24" r="2" fill="white"/>
                <circle cx="60" cy="24" r="2" fill="white"/>
              </svg>
            </div>
          {%- endif -%}
        </div>

      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Shea FAQ Accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subheading Text",
      "default": "We've got answers! If you don't see yours, just reach out — we love hearing from our <span class='faq-squad-link'>Snack Squad!</span> 🧡"
    },
    {
      "type": "image_picker",
      "id": "necklace_image",
      "label": "Necklace Illustration (Top Right)"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open First FAQ by Default",
      "default": true
    },
    {
      "type": "header",
      "content": "Bottom Contact Card"
    },
    {
      "type": "checkbox",
      "id": "show_contact_card",
      "label": "Show Contact Card",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "mascot_image",
      "label": "Mascot Image (Left side of card)"
    },
    {
      "type": "image_picker",
      "id": "jar_image",
      "label": "Pretzel Jar Image (Right side of card)"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Card Heading",
      "default": "Still have a question?"
    },
    {
      "type": "text",
      "id": "contact_subhead",
      "label": "Card Subheading",
      "default": "We're here to help and love hearing from you! 🧡"
    },
    {
      "type": "text",
      "id": "contact_btn_label",
      "label": "Button Text",
      "default": "CONTACT US"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 700,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Container Max Width",
      "default": 960
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What are Snacklaces?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Snacklaces are wearable pretzel necklaces that are super fun to wear and even better to eat! Each one is handmade with tasty ingredients and lots of love by 7-year-old snack boss, Shea. 🥨</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shea FAQ Accordion",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "What are Snacklaces?", "answer": "<p>Snacklaces are wearable pretzel necklaces that are super fun to wear and even better to eat! Each one is handmade with tasty ingredients and lots of love by 7-year-old snack boss, Shea. 🥨</p>" } },
        { "type": "faq_item", "settings": { "question": "What flavors do you offer?", "answer": "<p>We offer four delicious flavors: Original Pretzel ($3), Chocolate Pretzel ($5), White Chocolate Pretzel ($5), and Gluten-Free Pretzel ($5)!</p>" } },
        { "type": "faq_item", "settings": { "question": "Are Snacklaces safe for kids?", "answer": "<p>Yes! Our Snacklaces are made with simple, snackable ingredients. However, because they contain small pieces, we recommend adult supervision for children under 3 years old. Safety first, snacks second! 💛</p><p>See our <a href='/pages/whats-inside'>Ingredients & Allergens</a> page for full details.</p>" } },
        { "type": "faq_item", "settings": { "question": "What ingredients are in your Snacklaces?", "answer": "<p>We use quality pretzels, creamy coatings, and simple baking ingredients. See our <a href='/pages/whats-inside'>What's Inside & Allergens</a> page for complete ingredient lists.</p>" } },
        { "type": "faq_item", "settings": { "question": "Do you offer gluten-free options?", "answer": "<p>Yes! Our Gluten-Free Pretzel Snacklace is made with certified gluten-free pretzels so everyone can snack along!</p>" } },
        { "type": "faq_item", "settings": { "question": "How should I store my Snacklaces?", "answer": "<p>Store your Snacklaces in a cool, dry place away from direct sunlight. In warm weather, keep chocolate snacklaces cool so they don't melt!</p>" } },
        { "type": "faq_item", "settings": { "question": "How long do Snacklaces stay fresh?", "answer": "<p>Snacklaces stay fresh, crunchy, and delicious for up to 3 weeks in their sealed packaging.</p>" } },
        { "type": "faq_item", "settings": { "question": "Do you ship everywhere?", "answer": "<p>We currently ship anywhere in the United States! Orders typically process in 1-2 business days.</p>" } },
        { "type": "faq_item", "settings": { "question": "Can I order Snacklaces for a party or event?", "answer": "<p>Absolutely! Check out our <a href='/pages/party-packs'>Party Packs</a> (10, 20, or 50 count) or reach out via our <a href='/pages/contact'>Contact</a> page for custom party orders!</p>" } }
      ]
    }
  ]
}
{% endschema %}
