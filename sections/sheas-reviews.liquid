{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .shea-reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .shea-review-card {
    background: #FFFFFF;
    border: 3px solid var(--shea-border-color);
    border-radius: var(--shea-radius-card);
    box-shadow: var(--shea-shadow-card);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s;
  }

  .shea-review-card:hover {
    transform: translateY(-4px);
  }

  .shea-stars {
    color: #FFAD00;
    font-size: 1.2rem;
    margin-bottom: 12px;
    letter-spacing: 2px;
  }

  .shea-quote-text {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--shea-dark-brown);
    margin: 0 0 16px;
    font-style: italic;
  }

  .shea-reviewer-author {
    font-family: var(--shea-font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--shea-teal);
    margin: 0;
  }

  @media (max-width: 850px) {
    .shea-reviews-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin: 0 auto;
    }
  }
{%- endstyle -%}

<div id="SheaReviews-{{ section.id }}" class="section-{{ section.id }}-padding">
  <div class="shea-container">
    <div class="shea-section-header">
      <h2 class="shea-section-title">{{ section.settings.heading | default: "Snack Squad Says…" }}</h2>
      {%- if section.settings.subhead != blank -%}
        <p class="shea-section-subhead">{{ section.settings.subhead }}</p>
      {%- endif -%}
    </div>

    <div class="shea-reviews-grid">
      {%- for block in section.blocks -%}
        <div class="shea-review-card" {{ block.shopify_attributes }}>
          <div>
            <div class="shea-stars">★★★★★</div>
            <p class="shea-quote-text">“{{ block.settings.quote }}”</p>
          </div>
          <p class="shea-reviewer-author">— {{ block.settings.author }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shea Reviews Strip",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Snack Squad Says…"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Section Subheading",
      "default": "Loved by kids, trusted by parents! 🥨"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Quote",
          "default": "My kids wore them to the park and ate them on the way home. A+!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Reviewer Name / Title",
          "default": "Happy Parent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shea Reviews Strip",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "My kids wore them to the park and ate them on the way home. A+!",
            "author": "Happy Parent"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "The cutest, yummiest party favor ever.",
            "author": "Birthday Mom"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Finally, a snack that's also an accessory. Genius, Shea!",
            "author": "Snack Fan"
          }
        }
      ]
    }
  ]
}
{% endschema %}
