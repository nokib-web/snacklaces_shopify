{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .shea-contact-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 40px;
  }

  .shea-form-card {
    background: #FFFFFF;
    border: 3.5px solid var(--shea-border-color);
    border-radius: var(--shea-radius-card);
    box-shadow: var(--shea-shadow-card);
    padding: 32px;
  }

  .shea-form-field {
    margin-bottom: 20px;
  }

  .shea-form-label {
    display: block;
    font-family: var(--shea-font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--shea-dark-brown);
    margin-bottom: 8px;
  }

  .shea-input {
    width: 100%;
    padding: 14px 18px;
    border-radius: 14px;
    border: 2.5px solid var(--shea-border-color);
    background: #FFFDF4;
    font-family: var(--shea-font-body);
    font-size: 1rem;
    color: var(--shea-dark-brown);
    outline: none;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .shea-input:focus {
    border-color: var(--shea-teal);
    background: #FFFFFF;
  }

  .shea-textarea {
    min-height: 120px;
    resize: vertical;
  }

  /* Right Side Mascot with Speech Bubble */
  .shea-contact-mascot-wrap {
    position: relative;
    text-align: center;
  }

  .shea-speech-bubble {
    background: #FFFFFF;
    border: 3px solid var(--shea-border-color);
    border-radius: 20px;
    padding: 12px 20px;
    display: inline-block;
    font-family: var(--shea-font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--shea-teal);
    box-shadow: 0 4px 0 rgba(126, 73, 16, 0.15);
    margin-bottom: 16px;
    position: relative;
  }

  .shea-speech-bubble::after {
    content: "";
    position: absolute;
    bottom: -10px;
    left: 40%;
    border-width: 10px 10px 0;
    border-style: solid;
    border-color: #FFFFFF transparent;
    display: block;
    width: 0;
  }

  .shea-speech-bubble::before {
    content: "";
    position: absolute;
    bottom: -14px;
    left: calc(40% - 2px);
    border-width: 12px 12px 0;
    border-style: solid;
    border-color: var(--shea-border-color) transparent;
    display: block;
    width: 0;
  }

  .shea-contact-badges-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 36px;
  }

  .shea-contact-badge-card {
    background: #FFFBEA;
    border: 3px solid var(--shea-border-color);
    border-radius: 18px;
    box-shadow: 0 6px 0 rgba(126, 73, 16, 0.15);
    padding: 20px 16px;
    text-align: center;
  }

  .shea-contact-badge-icon {
    font-size: 2rem;
    margin-bottom: 8px;
  }

  .shea-contact-badge-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--shea-teal);
    margin: 0 0 4px;
  }

  .shea-contact-badge-desc {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--shea-dark-brown);
    margin: 0;
  }

  .shea-signoff-bar {
    text-align: center;
    margin-top: 36px;
    font-family: var(--shea-font-display);
    font-size: 1.25rem;
    color: var(--shea-dark-brown);
  }

  @media (max-width: 850px) {
    .shea-contact-grid {
      grid-template-columns: 1fr;
    }
    .shea-contact-badges-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 550px) {
    .shea-contact-badges-grid {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<div id="SheaContact-{{ section.id }}" class="section-{{ section.id }}-padding {% if section.settings.enable_confetti %}shea-confetti-bg{% endif %}">
  <div class="shea-container">
    <div class="shea-section-header">
      <h2 class="shea-section-title">{{ section.settings.heading | default: "SAY HI!" }}</h2>
      <p class="shea-section-subhead">
        {{ section.settings.subhead | default: "We'd love to hear from you! Questions, snack ideas, party orders, or just want to say hello? We're all ears!" }}
      </p>
    </div>

    <div class="shea-contact-grid">
      <!-- Left Form Card -->
      <div class="shea-form-card">
        {%- form 'contact', id: 'ContactForm' -%}
          {%- if form.posted_successfully? -%}
            <div class="shea-pill-badge" style="background: #E7F9F6; color: #0CBFA5; margin-bottom: 20px; width: 100%; justify-content: center;">
              🎉 Yay! Message sent! We'll get back to you soon!
            </div>
          {%- elsif form.errors -%}
            <div class="shea-pill-badge" style="background: #FFF0ED; color: #F05534; margin-bottom: 20px; width: 100%; justify-content: center;">
              Oops! Please check your details and try again.
            </div>
          {%- endif -%}

          <div class="shea-form-field">
            <label class="shea-form-label" for="ContactForm-name">{{ section.settings.name_label | default: "Your Name" }}</label>
            <input type="text" id="ContactForm-name" class="shea-input" name="contact[name]" placeholder="Type your name here..." value="{% if form.name %}{{ form.name }}{% endif %}" required>
          </div>

          <div class="shea-form-field">
            <label class="shea-form-label" for="ContactForm-email">{{ section.settings.email_label | default: "Your Email" }}</label>
            <input type="email" id="ContactForm-email" class="shea-input" name="contact[email]" placeholder="you@email.com" value="{% if form.email %}{{ form.email }}{% endif %}" spellcheck="false" autocomplete="email" autocorrect="off" autocapitalize="off" required>
          </div>

          <div class="shea-form-field">
            <label class="shea-form-label" for="ContactForm-body">{{ section.settings.message_label | default: "Your Message" }}</label>
            <textarea id="ContactForm-body" class="shea-input shea-textarea" name="contact[body]" placeholder="How can we help?" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>

          <button type="submit" class="shea-btn shea-btn-coral" style="width: 100%;">
            {{ section.settings.btn_label | default: "SEND IT! 🥨" }}
          </button>
        {%- endform -%}
      </div>

      <!-- Right Mascot with Speech Bubble -->
      <div class="shea-contact-mascot-wrap">
        <div class="shea-speech-bubble">
          {{ section.settings.speech_text | default: "Thanks for snacking with me! ❤️" }}
        </div>
        <div>
          {%- if section.settings.mascot_image != blank -%}
            {{ section.settings.mascot_image | image_url: width: 500 | image_tag: 
              loading: 'lazy',
              alt: "Shea Snack Boss"
            }}
          {%- else -%}
            <img src="{{ 'shea-waving.jpg' | asset_url }}" 
                 alt="Shea Waving" 
                 class="shea-hero-mascot-img" 
                 width="320" 
                 height="380" 
                 loading="lazy">
          {%- endif -%}
        </div>
      </div>
    </div>

    <!-- 4 Bottom Trust Badges -->
    <div class="shea-contact-badges-grid">
      <div class="shea-contact-badge-card" style="background: #E7F9F6;">
        <div class="shea-contact-badge-icon">💌</div>
        <h4 class="shea-contact-badge-title">We Read Every Message!</h4>
        <p class="shea-contact-badge-desc">We'll get back to you as soon as we can.</p>
      </div>
      <div class="shea-contact-badge-card" style="background: #FFFBEA;">
        <div class="shea-contact-badge-icon">🥨</div>
        <h4 class="shea-contact-badge-title" style="color: #F05534;">Made with Love</h4>
        <p class="shea-contact-badge-desc">Every Snacklace is handmade by me!</p>
      </div>
      <div class="shea-contact-badge-card" style="background: #FFF0ED;">
        <div class="shea-contact-badge-icon">❤️</div>
        <h4 class="shea-contact-badge-title">Snacks. Smiles. Good Times.</h4>
        <p class="shea-contact-badge-desc">That's what we're all about!</p>
      </div>
      <div class="shea-contact-badge-card" style="background: #FFF9E6;">
        <div class="shea-contact-badge-icon">🎉</div>
        <h4 class="shea-contact-badge-title" style="color: #F05534;">Party Orders?</h4>
        <p class="shea-contact-badge-desc">Tell us what you need. We love parties!</p>
      </div>
    </div>

    <!-- Sign-off -->
    <div class="shea-signoff-bar">
      {{ section.settings.signoff_text | default: "Thanks for being part of the Snack Squad! ❤️ — Shea" }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shea Contact",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "SAY HI!"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Section Subheading",
      "default": "We'd love to hear from you! Questions, snack ideas, party orders, or just want to say hello? We're all ears!"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name Field Label",
      "default": "Your Name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email Field Label",
      "default": "Your Email"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message Field Label",
      "default": "Your Message"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Submit Button Label",
      "default": "SEND IT! 🥨"
    },
    {
      "type": "text",
      "id": "speech_text",
      "label": "Mascot Speech Bubble Text",
      "default": "Thanks for snacking with me! ❤️"
    },
    {
      "type": "image_picker",
      "id": "mascot_image",
      "label": "Waving Shea Mascot Image"
    },
    {
      "type": "text",
      "id": "signoff_text",
      "label": "Bottom Sign-off Text",
      "default": "Thanks for being part of the Snack Squad! ❤️ — Shea"
    },
    {
      "type": "checkbox",
      "id": "enable_confetti",
      "label": "Enable Confetti Background",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Shea Contact"
    }
  ]
}
{% endschema %}
