{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .shea-about-card {
    background: #FFFDF4;
    border: 3.5px solid var(--shea-border-color);
    border-radius: var(--shea-radius-card);
    box-shadow: var(--shea-shadow-card);
    padding: 36px 40px;
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 36px;
    align-items: center;
  }

  .shea-about-title {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    color: var(--shea-coral);
    margin: 0 0 16px;
  }

  .shea-about-text {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--shea-dark-brown);
    margin-bottom: 24px;
  }

  .shea-about-img-wrap {
    text-align: center;
  }

  .shea-about-img {
    max-width: 100%;
    height: auto;
    border-radius: 20px;
  }

  @media (max-width: 750px) {
    .shea-about-card {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 24px;
    }
    .shea-about-img-wrap {
      order: -1;
    }
  }
{%- endstyle -%}

<div id="SheaAbout-{{ section.id }}" class="section-{{ section.id }}-padding">
  <div class="shea-container">
    <div class="shea-about-card">
      <div class="shea-about-content">
        <h2 class="shea-about-title">{{ section.settings.heading | default: "Hi, I'm Shea! 🥨" }}</h2>
        <div class="shea-about-text">
          {{ section.settings.story_text | default: "<p>I made my first snacklace because I wanted a snack I could wear to school. Now I make them for you too! Every necklace is handmade with love (and a little bit of glitter energy). Thanks for snacking with me!</p>" }}
        </div>
        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_link | default: '/pages/our-story' }}" class="shea-btn shea-btn-coral">
            {{ section.settings.btn_label }}
          </a>
        {%- endif -%}
      </div>

      <div class="shea-about-img-wrap">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 500 | image_tag: 
            class: 'shea-about-img',
            loading: 'lazy',
            alt: "Shea Snack Boss"
          }}
        {%- else -%}
          {{ 'shea-hero.png' | asset_url | image_tag: 
            class: 'shea-about-img',
            loading: 'lazy',
            alt: "Shea Snack Boss"
          }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shea About & Story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hi, I'm Shea! 🥨"
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story Body Text",
      "default": "<p>I made my first snacklace because I wanted a snack I could wear to school. Now I make them for you too! Every necklace is handmade with love (and a little bit of glitter energy). Thanks for snacking with me!</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Read Our Story →"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Shea Photo / Mascot"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Shea About & Story"
    }
  ]
}
{% endschema %}
