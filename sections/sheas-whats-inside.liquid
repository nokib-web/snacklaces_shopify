{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .shea-ingredients-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 36px;
  }

  .shea-ingredient-card {
    background: #FFFFFF;
    border: 3px solid var(--shea-border-color);
    border-radius: var(--shea-radius-card);
    box-shadow: var(--shea-shadow-card);
    padding: 24px;
    display: flex;
    gap: 20px;
    align-items: center;
  }

  .shea-ingredient-img-wrap {
    width: 120px;
    height: 120px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .shea-ingredient-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 4px 6px rgba(126, 73, 16, 0.15));
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .shea-ingredient-card:hover .shea-ingredient-img {
    transform: scale(1.08) rotate(-3deg);
  }

  .shea-ingredient-info {
    flex-grow: 1;
  }

  .shea-ingredient-title {
    font-size: 1.2rem;
    color: var(--shea-coral);
    margin: 0 0 6px;
    text-transform: uppercase;
  }

  .shea-ingredient-list {
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--shea-dark-brown);
    margin: 0 0 8px;
  }

  .shea-allergen-tag {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    color: #F05534;
    background: #FFF0ED;
    padding: 3px 10px;
    border-radius: var(--shea-radius-pill);
    border: 1.5px solid var(--shea-border-color);
  }

  /* Warning Banner */
  .shea-warning-banner {
    background-color: {{ section.settings.warning_bg | default: '#F05534' }};
    color: #FFFFFF;
    border: 3.5px solid var(--shea-border-color);
    border-radius: var(--shea-radius-card);
    box-shadow: var(--shea-shadow-card);
    padding: 28px 32px;
    display: grid;
    grid-template-columns: 80px 1fr 140px;
    align-items: center;
    gap: 24px;
  }

  .shea-warning-icon {
    width: 70px;
    height: 70px;
    background: #FFC923;
    border: 3px solid var(--shea-border-color);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .shea-warning-title {
    font-size: 1.4rem;
    color: #FFFFFF;
    margin: 0 0 8px;
    text-shadow: 1px 1px 0 rgba(0,0,0,0.2);
  }

  .shea-warning-text {
    font-size: 1rem;
    line-height: 1.45;
    margin: 0;
  }

  .shea-warning-mascot {
    text-align: center;
  }

  .shea-warning-mascot img,
  .shea-warning-mascot svg {
    max-width: 120px;
    height: auto;
  }

  @media (max-width: 850px) {
    .shea-ingredients-grid {
      grid-template-columns: 1fr;
    }
    .shea-warning-banner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .shea-warning-icon,
    .shea-warning-mascot {
      margin: 0 auto;
    }
  }
{%- endstyle -%}

<div id="SheaWhatsInside-{{ section.id }}" class="section-{{ section.id }}-padding">
  <div class="shea-container">
    <div class="shea-section-header">
      <h2 class="shea-section-title">{{ section.settings.heading | default: "WHAT'S INSIDE" }}</h2>
      <p class="shea-section-subhead">
        {{ section.settings.subhead | default: "We believe snack time should be fun AND worry-free. Here's exactly what goes into every Snacklace — no mystery, just yumminess!" }}
      </p>
    </div>

    <!-- 4 Flavor Ingredients Cards -->
    <div class="shea-ingredients-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_image = blank
          if block.settings.flavor_image != blank
            assign card_image = block.settings.flavor_image
          elsif block.settings.product != blank and block.settings.product.featured_image != blank
            assign card_image = block.settings.product.featured_image
          else
            case forloop.index
              when 1
                assign auto_product = all_products['original-pretzel-snacklace']
              when 2
                assign auto_product = all_products['chocolate-pretzel-snacklace']
              when 3
                assign auto_product = all_products['white-chocolate-pretzel-snacklace']
              when 4
                assign auto_product = all_products['gluten-free-pretzel-snacklace']
            endcase
            if auto_product != blank and auto_product.featured_image != blank
              assign card_image = auto_product.featured_image
            endif
          endif
        -%}
        <div class="shea-ingredient-card" {{ block.shopify_attributes }}>
          <div class="shea-ingredient-img-wrap">
            {%- if card_image != blank -%}
              {{ card_image | image_url: width: 240 | image_tag: 
                class: 'shea-ingredient-img',
                loading: 'lazy',
                alt: block.settings.title | escape
              }}
            {%- else -%}
              <svg viewBox="0 0 100 100" width="90" height="90" fill="none">
                <circle cx="50" cy="50" r="42" fill="#FFC923" stroke="#7E4910" stroke-width="3"/>
                <circle cx="50" cy="50" r="24" fill="{{ block.settings.accent_color | default: '#FFAD00' }}" stroke="#7E4910" stroke-width="3"/>
              </svg>
            {%- endif -%}
          </div>

          <div class="shea-ingredient-info">
            <h3 class="shea-ingredient-title" style="color: {{ block.settings.title_color | default: '#F05534' }};">
              {{ block.settings.title }}
            </h3>
            <p class="shea-ingredient-list">
              <strong>Ingredients:</strong> {{ block.settings.ingredients }}
            </p>
            {%- if block.settings.allergen_info != blank -%}
              <span class="shea-allergen-tag">{{ block.settings.allergen_info }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    <!-- The Important (Not-so-silly) Stuff Warning Banner -->
    <div class="shea-warning-banner">
      <div class="shea-warning-icon">
        <svg viewBox="0 0 24 24" width="40" height="40" fill="#F05534">
          <path d="M12 2L1 21h22L12 2zm0 4l7.53 13H4.47L12 6zm-1 5v4h2v-4h-2zm0 6v2h2v-2h-2z"/>
        </svg>
      </div>

      <div class="shea-warning-body">
        <h3 class="shea-warning-title">{{ section.settings.warning_heading | default: "THE IMPORTANT (NOT-SO-SILLY) STUFF" }}</h3>
        <div class="shea-warning-text">
          <p>{{ section.settings.warning_text | default: "Our Snacklaces are handmade in a kitchen that also handles wheat, milk, soy, tree nuts, peanuts. If you have allergies, please check with a grown-up before you snack!" }}</p>
          <p style="margin-top: 6px;"><strong>{{ section.settings.safety_notice | default: "The string is not for eating — just the snacks! Snacklaces are meant to be enjoyed fresh and worn with a grown-up nearby for little ones." }}</strong></p>
        </div>
      </div>

      <div class="shea-warning-mascot">
        {%- if section.settings.warning_mascot_image != blank -%}
          {{ section.settings.warning_mascot_image | image_url: width: 240 | image_tag: 
            loading: 'lazy',
            alt: "Shea Snack Boss"
          }}
        {%- else -%}
          {{ 'faq-shea-mascot.png' | asset_url | image_tag: 
            loading: 'lazy',
            alt: "Shea Snack Boss"
          }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shea What's Inside",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "WHAT'S INSIDE"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Section Subheading",
      "default": "We believe snack time should be fun AND worry-free. Here's exactly what goes into every Snacklace — no mystery, just yumminess!"
    },
    {
      "type": "text",
      "id": "warning_heading",
      "label": "Warning Box Title",
      "default": "THE IMPORTANT (NOT-SO-SILLY) STUFF"
    },
    {
      "type": "textarea",
      "id": "warning_text",
      "label": "Allergen Warning Copy",
      "default": "Our Snacklaces are handmade in a kitchen that also handles wheat, milk, soy, tree nuts, peanuts. If you have allergies, please check with a grown-up before you snack!"
    },
    {
      "type": "textarea",
      "id": "safety_notice",
      "label": "Safety Notice Copy",
      "default": "The string is not for eating — just the snacks! Snacklaces are meant to be enjoyed fresh and worn with a grown-up nearby for little ones."
    },
    {
      "type": "color",
      "id": "warning_bg",
      "label": "Warning Banner Background Color",
      "default": "#F05534"
    },
    {
      "type": "image_picker",
      "id": "warning_mascot_image",
      "label": "Advising Mascot Image (Shea Character)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "ingredient_item",
      "name": "Flavor Ingredients Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Flavor Title",
          "default": "ORIGINAL PRETZEL SNACKLACE"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#F05534"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Link Store Product (Auto-loads Product Image)"
        },
        {
          "type": "image_picker",
          "id": "flavor_image",
          "label": "Custom Flavor Image (Optional override)"
        },
        {
          "type": "textarea",
          "id": "ingredients",
          "label": "Ingredients List",
          "default": "Enriched wheat flour, salt, yeast, vegetable oil, malted barley."
        },
        {
          "type": "text",
          "id": "allergen_info",
          "label": "Allergen Badge (Contains)",
          "default": "Contains: [Wheat]"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shea What's Inside",
      "blocks": [
        {
          "type": "ingredient_item",
          "settings": {
            "title": "ORIGINAL PRETZEL SNACKLACE",
            "title_color": "#0CBFA5",
            "ingredients": "Enriched flour, salt, yeast, malt.",
            "allergen_info": "Contains: [Wheat]"
          }
        },
        {
          "type": "ingredient_item",
          "settings": {
            "title": "CHOCOLATE PRETZEL SNACKLACE",
            "title_color": "#F05534",
            "ingredients": "Pretzels + chocolate coating (sugar, cocoa, milk, soy lecithin).",
            "allergen_info": "Contains: [Wheat, Milk, Soy]"
          }
        },
        {
          "type": "ingredient_item",
          "settings": {
            "title": "WHITE CHOCOLATE PRETZEL SNACKLACE",
            "title_color": "#0CBFA5",
            "ingredients": "Pretzels + white chocolate coating (sugar, milk, cocoa butter, vanilla).",
            "allergen_info": "Contains: [Wheat, Milk, Soy]"
          }
        },
        {
          "type": "ingredient_item",
          "settings": {
            "title": "GLUTEN-FREE PRETZEL SNACKLACE",
            "title_color": "#F05534",
            "ingredients": "Gluten-free flour blend (brown rice flour, tapioca starch), salt, yeast.",
            "allergen_info": "Certified Gluten-Free"
          }
        }
      ]
    }
  ]
}
{% endschema %}
